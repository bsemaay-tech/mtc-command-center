# Auto detect text files and perform LF normalization
* text=auto
MTC_COMMAND_CENTER/11_TRIAGE/KVM2_PROGRAM/evidence/ledger_schema.json text eol=lf

# WP-P0-12 gate reproducibility: the corrected-vnext gate hashes working-tree bytes
# (harness_sha256, probe modified-copy digests, catalog/design/baseline digests).
# `* text=auto` alone leaves checkout conversion to core.eol, which defaults to
# `native` = CRLF on Windows, so the same commit materialises differently per host
# and the gate's recorded identities cannot be reproduced. Pin these paths to LF so
# a fresh checkout yields deterministic bytes and therefore deterministic hashes.
MTC_COMMAND_CENTER/01_MTC_PROJECT/00_PYTHON/mtc_v2/**/*.py     text eol=lf
MTC_COMMAND_CENTER/01_MTC_PROJECT/00_PYTHON/mtc_v2/**/*.json   text eol=lf
MTC_COMMAND_CENTER/01_MTC_PROJECT/00_PYTHON/mtc_v2/**/*.sha256 text eol=lf
MTC_COMMAND_CENTER/01_MTC_PROJECT/00_PYTHON/mtc_v2/**/*.patch  text eol=lf
MTC_COMMAND_CENTER/01_MTC_PROJECT/00_PYTHON/mtc_v2/**/*.md     text eol=lf
