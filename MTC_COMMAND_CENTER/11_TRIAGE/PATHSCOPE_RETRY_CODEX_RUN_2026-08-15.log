 1401:     def split_list_members(text: str) -> list[str]:
 1402:         """Split one assignment value into the consumer's `:` list members.
 1403: 
 1404:         A path list is split by the consumer regardless of shell quoting, so
 1405:         this runs on every candidate, including one that starts with `/`. Only
 1406:         a URI's `scheme://authority` span is protected from splitting: round 4
 1407:         protected the complete value whenever it merely *started* with a scheme,
 1408:         so `LD_LIBRARY_PATH=$URL:/etc/escape` produced an allowed endpoint and
 1409:         no row at all for `/etc/escape` (C-3). A member that itself begins a new
 1410:         URI re-arms the protection, so `a://h/x:b://h/y` splits into two URIs.
 1411:         """
 1412:         members: list[str] = []
 1413:         start = 0
 1414:         index = 0
 1415:         while index < len(text):
 1416:             if index == start:
 1417:                 prefix = URI_PREFIX_RE.match(text, index)
 1418:                 if prefix is not None and prefix.end() > index:
 1419:                     index = prefix.end()
 1420:                     continue
 1421:             if text[index] == ":":
 1422:                 members.append(text[start:index])
 1423:                 start = index + 1
 1424:                 index = start
 1425:                 continue
 1426:             index += 1
 1427:         members.append(text[start:])
 1428:         return members
