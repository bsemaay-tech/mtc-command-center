 1373:     def assignment_member_kind(text: str) -> str:
 1374:         """Terminal classification of one assignment-value member.
 1375: 
 1376:         `net` a scheme URI, `fs` a pathname, `empty` an empty member, `bare` a
 1377:         name that carries no pathname at all. `bare` is the single disclosed
 1378:         residual of this construct: a member with no `/` (a soname like
 1379:         `libc.so`, a scalar like `1`, an option word) is resolved by the
 1380:         consumer's own search rules, not by an argv pathname, so it is outside
 1381:         the lexical-argv-scope contract this tool proves.
 1382: 
 1383:         C-3 repair (round 5): a relative value carrying `:` used to fall through
 1384:         to `bare`, so the admitted single-pathname reading of `X=relative:$BASE`
 1385:         -- `<PWD>/relative:dir/file` -- had no terminal disposition at all even
 1386:         though the whole candidate was carried into the pool. `:` is a list
 1387:         separator for the *members*; it does not stop the whole value from being
 1388:         a pathname, exactly as it never did for a value starting with `/`.
 1389:         """
 1390:         if text == "":
 1391:             return "empty"
 1392:         if URI_SCHEME_RE.match(text):
 1393:             return "net"
 1394:         if text.startswith(("/", "./", "../")):
 1395:             return "fs"
 1396:         if "/" in text and not text.startswith("-"):
 1397:             return "fs"  # ordinary relative pathname, resolved against pinned PWD
 1398:         return "bare"
