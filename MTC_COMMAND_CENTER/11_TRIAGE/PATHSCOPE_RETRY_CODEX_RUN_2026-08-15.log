    XARGS_SPEC = spec(
        "xargs",
        flags="-0 -r -t -x -p -o --null --no-run-if-empty --verbose --exit "
              "--interactive --open-tty --show-limits",
        path="-a --arg-file",
        data="-d --delimiter -I -i --replace -n --max-args -P --max-procs -s "
             "--max-chars -L --max-lines -E -e --eof --process-slot-var",
        odata="--replace --eof",
        rest="data",
