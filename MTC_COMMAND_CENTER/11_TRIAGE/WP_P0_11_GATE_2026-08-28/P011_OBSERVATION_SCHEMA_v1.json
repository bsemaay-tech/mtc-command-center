{
  "array_contracts": {
    "completed_exit_ids": "lexicographically sorted",
    "entry_legs": "producer order",
    "events": "ordered by event_ordinal; duplicate ordinals are invalid",
    "gate_results": "gate_name ascending",
    "working_exits": "producer order"
  },
  "closed": true,
  "csv_binding": {
    "bar_index_derivation": "zero-based physical data-row ordinal after the header",
    "exact_header": "ts,open,high,low,close,volume",
    "numeric_sources": [
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "rejects": [
      "supplied index column",
      "skipped ordinal",
      "timestamp/index disagreement",
      "duplicate observation identity"
    ],
    "timestamp_source": "ts"
  },
  "digest_catalog": {
    "canonical_json": "UTF-8, sort_keys=true, separators=(',', ':'), ensure_ascii=false, allow_nan=false",
    "event_component_paths": [
      "events[*].event_ordinal",
      "events[*].event_kind",
      "events[*].side",
      "events[*].reason",
      "events[*].price",
      "events[*].qty",
      "events[*].lifecycle_id",
      "events[*].exit_id",
      "events[*].realized_pnl",
      "events[*].was_partial",
      "events[*].was_pessimistic"
    ],
    "state_digest_algorithm": "sha256(canonical_json({events,position,gate_readiness,account}))",
    "state_digest_components": [
      "events[*].event_ordinal",
      "events[*].event_kind",
      "events[*].side",
      "events[*].reason",
      "events[*].price",
      "events[*].qty",
      "events[*].lifecycle_id",
      "events[*].exit_id",
      "events[*].realized_pnl",
      "events[*].was_partial",
      "events[*].was_pessimistic",
      "position.present",
      "position.lifecycle_id",
      "position.side",
      "position.entry_price",
      "position.avg_entry_price",
      "position.qty",
      "position.entry_bar",
      "position.initial_qty",
      "position.active_stop_price",
      "position.active_tp_price",
      "position.active_stop_owner",
      "position.be_active",
      "position.trail_active",
      "position.trail_price",
      "position.initial_risk_per_unit",
      "position.working_exit_reference_qty",
      "position.working_exit_book_version",
      "position.entry_legs[*].entry_price",
      "position.entry_legs[*].qty",
      "position.entry_legs[*].entry_bar",
      "position.working_exits[*].exit_id",
      "position.working_exits[*].kind",
      "position.working_exits[*].target_price",
      "position.working_exits[*].stop_price",
      "position.working_exits[*].qty_fraction",
      "position.working_exits[*].book_version",
      "position.working_exits[*].active",
      "position.completed_exit_ids[*]",
      "gate_readiness.warmup_bars",
      "gate_readiness.block_new_entries_this_bar",
      "gate_readiness.opened_this_bar_reason",
      "gate_readiness.closed_this_bar_reason",
      "gate_readiness.gated_long",
      "gate_readiness.gated_short",
      "gate_readiness.gate_results[*].gate_name",
      "gate_readiness.gate_results[*].long_ok",
      "gate_readiness.gate_results[*].short_ok",
      "gate_readiness.gate_results[*].value",
      "gate_readiness.gate_results[*].category",
      "account.equity",
      "account.realized_equity",
      "account.unrealized_pnl",
      "account.last_sizing_equity_snapshot",
      "account.total_entries",
      "account.total_exits"
    ]
  },
  "excluded_fields": [
    {
      "path": "Bar.indicators",
      "reason": "caller-supplied auxiliary map; not used by the two frozen profiles"
    },
    {
      "path": "Bar.htf",
      "reason": "legacy compatibility alias map; the frozen profiles do not provide HTF data"
    },
    {
      "path": "PortfolioState.current_bar_index",
      "reason": "duplicate of observation.bar_index"
    },
    {
      "path": "PortfolioState.last_entry_bar_index",
      "reason": "derivable lifecycle diagnostic not declared in v1"
    },
    {
      "path": "PortfolioState.last_exit_bar_index",
      "reason": "derivable from ordered events"
    },
    {
      "path": "PortfolioState.last_exit_price/qty/id/reason flags",
      "reason": "represented losslessly in ordered events"
    },
    {
      "path": "PortfolioState.initial_capital",
      "reason": "pinned in the full resolved config snapshot"
    },
    {
      "path": "PortfolioState.execution_profile_id",
      "reason": "pinned by profile_id and resolved config"
    },
    {
      "path": "PortfolioState.instrument",
      "reason": "pinned in the full resolved config snapshot"
    },
    {
      "path": "PortfolioState.indicator_snapshot",
      "reason": "internal calculation state; raw and gated producer outputs are observed instead"
    },
    {
      "path": "PortfolioState.regime_lock_side",
      "reason": "undeclared internal control state in schema v1"
    },
    {
      "path": "PortfolioState.next_position_lifecycle_id",
      "reason": "next-id allocator internal; active/event lifecycle IDs are observed"
    },
    {
      "path": "Runner private trackers and histories",
      "reason": "undeclared implementation internals"
    },
    {
      "path": "Runner debug metadata",
      "reason": "debug-only and configuration-redundant"
    },
    {
      "path": "arbitrary repr/object address/unordered set iteration",
      "reason": "non-canonical and forbidden"
    }
  ],
