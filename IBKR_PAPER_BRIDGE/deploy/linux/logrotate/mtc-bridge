# /etc/logrotate.d/mtc-bridge — persistent bridge log rotation.
#
# The unit writes with StandardOutput=append:, so the file handle stays open for
# the process lifetime. `copytruncate` therefore rotates without needing a
# service restart — restarting the bridge to rotate a log is forbidden.
#
# Policy: daily, seven generations retained, compressed with a one-generation
# delay, and early rotation when either active log exceeds 64 MiB. At the
# threshold the uncompressed retention budget is two logs x eight files
# (active + seven generations) x 64 MiB = 1 GiB. `maxsize` is checked only
# when logrotate runs, so this is not a hard disk quota: active growth between
# daily runs can exceed it, and the policy-only absolute worst case is
# unbounded until the next invocation. MemoryMax protects RAM, not log disk.

/var/log/mtc-bridge/bridge.log /var/log/mtc-bridge/bridge.err.log {
    daily
    rotate 7
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
    su mtc-bridge mtc-bridge
    create 0640 mtc-bridge mtc-bridge
}
